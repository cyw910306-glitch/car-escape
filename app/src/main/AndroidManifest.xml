<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK 2.3.2: read permissions per @RequiresPermission (see docs/pleos-api-notes.md) -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- window position, window lock, wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- reading light, turn signal, ambient get -->
    <!-- ambient set: emulator rejects with "need Permission" without this (verified 2026-10-23) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />   <!-- SoC, charge switch, charge port open -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- gear, remaining range, drive mode (read only) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />    <!-- seat heat, occupancy, belt -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />  <!-- steering wheel heat -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />    <!-- door position: pause only (Door.registerDoorPosition) -->
    <!-- Ambient setters are annotated CAR_LIGHTS in 2.3.2 bytecode, but the emulator also requires CONTROL_CAR_LIGHTS (declared above). -->

    <!-- AAOS CarPropertyManager: speed, gear fallback, EV charge state / time remaining -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />

    <!-- TextToSpeech engine binding (package visibility, API 30+) -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="카 이스케이프"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- No distractionOptimized meta-data on purpose: game must be hidden while driving. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
